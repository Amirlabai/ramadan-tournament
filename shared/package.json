{
  "name": "@ramadan-tournament/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.ts",
      "require": "./dist/index.js"
    },
    "./birthYearBounds": {
      "types": "./dist/birthYearBounds.d.ts",
      "import": "./birthYearBounds.ts",
      "require": "./dist/birthYearBounds.js"
    },
    "./israeliIdValidation": {
      "types": "./dist/israeliIdValidation.d.ts",
      "import": "./israeliIdValidation.ts",
      "require": "./dist/israeliIdValidation.js"
    }
  },
  "description": "Shared validation constants. Client: Vite alias → source .ts. Server: require → dist/ (built by `npm run build:shared`, root `npm run build`, server `build`, and `prepare` on install unless `--ignore-scripts`).",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
