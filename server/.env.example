# --- Admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# SEASON_YEAR_MONTH=2026-06
# SEASON_DISPLAY_NAME=טורניר קיץ 2026
# Fresh season: npm run db:fresh (see server/README.md)
# --- Auth / security ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GOOGLE_CLIENT_ID=
JWT_SECRET=

# --- Database ---
DATABASE_URL=

# --- Email ---
SMTP_PASS=
SMTP_USER=
# TOURNAMENT_DISPLAY_NAME_HE=גביע העולם אדיגה 2026
# SITE_PUBLIC_URL=https://ramadan-tournament-client.vercel.app

# --- Local dev (optional) ---
# MOCK_DEV_DATA=1   # or: npm run dev:mock (uses env.mock)

# --- PII encryption (production + import:prereg) ---
# 32-byte key, base64-encoded. Same value on Render API and local server/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PERSONAL_ID_KEY=
# After migrate:personal-ids on production, enable strict lookup-only mode:
# PERSONAL_ID_MIGRATION_DONE=1

# --- Redis ---
REDIS_URL=

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- World Cup (optional) ---
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_DATA_SEASON=2026
WORLD_CUP_ENABLED=
WORLD_CUP_ONLY=

# --- Automation (optional) ---
GEMINI_API_KEY=
# GitHub Actions backup-postgres.yml uses secrets.DATABASE_URL (Render external URL)
