{
    "name": "server",
    "version": "2.0.0",
    "private": true,
    "description": "Tournament backend API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:mock": "tsx watch src/index.ts",
        "build": "npm run build --workspace=@ramadan-tournament/shared && prisma generate && tsc && tsc -p tsconfig.seed.json",
        "start": "node dist/index.js",
        "postinstall": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:validate": "prisma validate",
        "db:seed": "tsx prisma/seed.ts",
        "db:fresh": "tsx prisma/seed-empty.ts",
        "db:studio": "prisma studio",
        "fixtures:generate": "tsx src/scripts/generate-group-fixtures.ts",
        "parse:prereg": "tsx src/scripts/parse-adiga-form-csv.ts",
        "import:prereg": "tsx src/scripts/import-adiga-form-prereg.ts",
        "import:roster": "tsx src/scripts/import-adiga-form-roster.ts",
        "migrate:personal-ids": "tsx src/scripts/migrate-personal-id-encryption.ts",
        "migrate:user-emails": "tsx src/scripts/migrate-normalize-user-emails.ts",
        "uploads:compress": "tsx src/scripts/compress-uploads.ts",
        "db:sync-banned-words": "tsx src/scripts/syncBannedWords.ts",
        "wc:locale": "tsx scripts/buildWorldCupPlayerLocale.ts",
        "analytics:explorer": "tsx src/scripts/analytics-explorer-server.ts",
        "analytics:explorer:dev": "tsx watch src/scripts/analytics-explorer-server.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^6.5.0",
        "@ramadan-tournament/shared": "*",
        "@types/bcrypt": "^5.0.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.11.5",
        "@types/nodemailer": "^7.0.11",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "google-auth-library": "^10.6.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.6.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.1",
        "prisma": "^6.5.0",
        "sharp": "^0.34.5",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/supertest": "^6.0.3",
        "supertest": "^7.1.0",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "tar": "^7.5.11"
    }
}
