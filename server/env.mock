# Loaded automatically when you run: npm run dev:mock (from server/ or root dev:mock)
MOCK_DEV_DATA=1
JWT_SECRET=mock-dev-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
NODE_ENV=development
# Optional: enable World Cup mock API (also set VITE_WORLD_CUP_* in client/.env)
WORLD_CUP_ENABLED=true
